# Secret used by the client to sign requests. Must match the APP_SECRET compiled into the maskd binary.
APP_SECRET=your-super-secret-app-secret

# The actual key used to decrypt the models (base64 encoded). 
# This must match what encrypt_weights.py used.
MODEL_DECRYPTION_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Time drift allowed for request signatures (seconds)
MAX_TIMESTAMP_DRIFT=30
